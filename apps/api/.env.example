NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
MONGO_URI=mongodb://127.0.0.1:27017/documan
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Optional SMTP Email Configuration (Required for sending actual OTP emails to physical inboxes)
# If unconfigured in dev mode, OTP codes are logged to console and displayed in dev UI mode.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Documan Security <no-reply@documan.app>"
# SMTP_SECURE=false